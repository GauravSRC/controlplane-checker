# ControlPlane Checker — environment configuration TEMPLATE
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
# Settings are read via pydantic-settings with the CONTROLPLANE_ prefix
# (bare names below are the canonical keys; see controlplane/config.py).

# ============================================================
# Provider — Groq (free tier)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here

# Model under governance (the app-facing model the proxy wraps)
GOVERNED_MODEL=groq/llama-3.1-8b-instant

# Safety guard model (content safety)
GUARD_SAFETY_MODEL=groq/meta-llama/llama-guard-4-12b

# Injection / jailbreak guard model (Prompt Guard) — confirm exact Groq ID
GUARD_INJECTION_MODEL=groq/meta-llama/llama-prompt-guard-2-86m

# ============================================================
# Local NLI / embeddings (CPU, downloaded from HuggingFace on first run)
# ============================================================
NLI_MODEL=cross-encoder/nli-deberta-v3-small
SPACY_MODEL=en_core_web_sm

# ============================================================
# Proxy server
# ============================================================
HOST=127.0.0.1
PORT=8000
# Default use-case profile / policy pack loaded at startup
DEFAULT_POLICY_PACK=india-dpdp
# Global flag budget ceiling (% of traffic allowed to reach human review)
FLAG_BUDGET_PCT=3.0

# ============================================================
# Telemetry — OpenTelemetry -> OTLP -> Arize Phoenix (local)
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OTEL_SERVICE_NAME=controlplane-checker
PHOENIX_PORT=6006

# ============================================================
# Storage
# ============================================================
# SQLite evidence + feedback store (gitignored)
LEDGER_DB_PATH=data/controlplane.db

# ============================================================
# Runtime
# ============================================================
LOG_LEVEL=INFO
# Fail-open (log degradation) vs fail-closed default when a detector times out.
# Per-route overrides come from the policy pack; this is the global fallback.
FAIL_MODE=fail_open
