# --- Secrets & environment ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
.venv*/
venv/
env/

# --- Databases / local stores ---
*.db
*.sqlite
*.sqlite3

# --- Data artifacts (keep the folder, ignore generated data) ---
data/*.csv
data/*.parquet
data/*.log

# Regenerable, but COMMITTED on purpose:
#   data/eval_set.jsonl    - the labeled eval set (deterministic from a seed, but
#                            judges must see exactly what was measured)
#   data/guard_cache.json  - cached guard verdicts; makes `make eval` run offline in
#                            ~0.2s with zero API calls during the demo
#   data/plots/*.png       - presentation figures referenced by the pitch deck
!data/eval_set.jsonl
!data/guard_cache.json
!data/plots/

# --- Telemetry / traces ---
*.otlp
phoenix_data/
.phoenix/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
